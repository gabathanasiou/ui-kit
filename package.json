{
  "name": "@gabriel/ui-kit",
  "version": "0.1.14",
  "description": "Shared interaction primitives: device/touch detection, menus, dialogs, long-press. Extracted from the lemon_schedule app.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ui-kit.css": "./dist/ui-kit.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:js && npm run build:types && npm run build:css",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "cp src/styles/tokens.css dist/ui-kit.css"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
